#!/bin/sh

set -u

limit=600
violations=$(
  git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r path; do
    case "$path" in
      bun.lock|*.lock|package-lock.json) continue ;;
    esac
    line_count=$(git show ":$path" | awk 'END { print NR }')
    if [ "$line_count" -gt "$limit" ]; then
      head_count=$(git show "HEAD:$path" 2>/dev/null | awk 'END { print NR }')
      if [ -n "$head_count" ] && [ "$head_count" -gt "$limit" ]; then
        continue
      fi
      printf 'pre-commit:   %s (%s lines)\n' "$path" "$line_count"
    fi
  done
)

if [ -n "$violations" ]; then
  printf 'pre-commit: staged files exceed the %s-line limit:\n' "$limit" >&2
  printf '%s\n' "$violations" >&2
  printf '%s\n' "pre-commit: restructure each file into smaller, focused modules before committing." >&2
  exit 1
fi
