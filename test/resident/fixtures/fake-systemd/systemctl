#!/usr/bin/env bun
import { readFile, readdir } from "node:fs/promises"
import { readFileSync } from "node:fs"
import { join } from "node:path"

const root = process.env.RESIDENT_FAKE_SYSTEMD_ROOT
if (!root) throw new Error("RESIDENT_FAKE_SYSTEMD_ROOT required")
const args = process.argv.slice(2).filter((arg) => arg !== "--user" && arg !== "--no-pager")
const action = args[0]
const unit = args.at(-1)
if (!unit) throw new Error("unit required")
const path = join(root, `${unit}.json`)
const state = await readFile(path, "utf8").then(JSON.parse, () => null)
const live = (pid) => {
  try {
    process.kill(pid, 0)
    return !readFileSync(`/proc/${pid}/stat`, "utf8").split(") ")[1]?.startsWith("Z ")
  } catch {
    return false
  }
}
if (action === "show") {
  const active = state && live(state.pid)
  console.log(
    `LoadState=${state ? "loaded" : "not-found"}\nMainPID=${active ? state.pid : 0}\nInvocationID=${state?.invocation ?? ""}\nDescription=${state?.description ?? ""}\nActiveState=${active ? "active" : "inactive"}\nSubState=${active ? "running" : "dead"}\nResult=success`,
  )
} else if (action === "stop" || action === "kill") {
  if (state && live(state.pid)) {
    try {
      process.kill(
        -state.pid,
        action === "kill" || process.env.RESIDENT_FAKE_STOP_FAIL === "1" ? "SIGKILL" : "SIGTERM",
      )
    } catch {}
  }
  if (
    (action === "stop" && process.env.RESIDENT_FAKE_STOP_FAIL === "1") ||
    (action === "kill" && process.env.RESIDENT_FAKE_KILL_FAIL === "1")
  ) {
    await Bun.sleep(30)
    process.exit(1)
  }
} else if (action === "reset-failed") {
  // A stopped transient name can be launched again.
} else if (action === "list-units") {
  for (const name of await readdir(root).catch(() => [])) {
    if (!name.endsWith(".service.json")) continue
    const candidate = name.slice(0, -5)
    if (candidate.startsWith(unit.replace(/\*$/, "")))
      console.log(`${candidate} loaded active running fixture`)
  }
} else throw new Error(`unsupported systemctl action ${action}`)
