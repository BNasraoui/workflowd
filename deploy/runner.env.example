WORKFLOWD_NATS_SERVERS=nats://control.example-tailnet.ts.net:4222
WORKFLOWD_REMOTE_HOST_ID=this-host
WORKFLOWD_REMOTE_DATABASE_PATH=/home/USER/.local/state/workflowd-runner/runner.db

# NATS credentials: the runner needs exactly one source among
# WORKFLOWD_NATS_TOKEN, WORKFLOWD_NATS_TOKEN_FILE, WORKFLOWD_NATS_CREDS, and
# WORKFLOWD_NATS_CREDS_FILE. Keep credential material out of this file; the
# systemd unit supplies it through LoadCredential.
#
# Per-identity mode (recommended; see docs/remote-runner.md): install this
# host's .creds file at ~/.config/workflowd/runner.creds with mode 0600 and
# add a drop-in workflowd-runner.service.d/20-nats-creds.conf:
#   [Service]
#   LoadCredential=nats-creds:%h/.config/workflowd/runner.creds
#   Environment=WORKFLOWD_NATS_TOKEN_FILE=
#   Environment=WORKFLOWD_NATS_CREDS_FILE=%d/nats-creds
# Blanking WORKFLOWD_NATS_TOKEN_FILE disables the token source the shipped
# unit sets; an empty value counts as unset.
#
# Shared-token mode (smoke tests only; a token carries no subject
# permissions, so any credential holder can read every host's commands): the
# shipped workflowd-runner.service already loads
# ~/.config/workflowd/nats-token via LoadCredential and sets
# WORKFLOWD_NATS_TOKEN_FILE.
