# The environment file of deploy/systemd/workflowd-gateway.service, at
# /etc/workflowd-gateway/gateway.env, owner root, mode 0600. See docs/runner-placement.md,
# operator step 2. Replace each <placeholder>. The file holds no secret: the gateway's login comes
# in only through import-login.
#
# The published gateway image, by digest only.
WORKFLOWD_GATEWAY_IMAGE=ghcr.io/bnasraoui/workflowd-gateway@sha256:<64 hex>
# The same gid as daemon.gid: the gateway gives its control socket's directory this group.
WORKFLOWD_GATEWAY_DAEMON_GID=<daemon-gid>
# The same gid as listen.front.gid: the gateway gives its listener's directory this group.
WORKFLOWD_GATEWAY_FRONT_GID=<front-gid>
# The gateway's configuration (docs/capability-gateway.md), one line, in single quotes. The paths
# are the paths of the unit's state directory and of the image; do not change them.
#   noscope.binary, noscope.configHome: noscope of the image; the provider-access template.
#   storePath, controlSocket: the gateway's store and the socket of the daemon.
#   daemon.uid, daemon.gid: the uid and gid of the workflowd daemon.
#   login.directory: the gateway's login; import-login makes it, mode 0700.
#   providerId: anthropic, the id of the gateway's model route in the runner's request paths.
#   credentialRole: claude, the one provider of custody's table (custody.ts); the role of
#     provider-access and the name that import-login takes.
#   maxStreams, maxStreamsPerRun: for example 64 and 4.
#   gitRead: true; the runner reads the source through the gateway's Git route.
#   listen.socket: the socket that Tailscale Serve reaches.
#   listen.front.uid, listen.front.gid: the fixed uid and gid of the system user
#     workflowd-gateway-front, whose tailscaled runs Serve (workflowd-gateway-front.service).
#   listen.service: <service-name>.<tailnet-name>.ts.net, in lower case.
WORKFLOWD_CAPABILITY_GATEWAY='{"noscope":{"binary":"/bin/noscope","configHome":"/var/lib/workflowd-gateway/config"},"storePath":"/var/lib/workflowd-gateway/gateway.db","controlSocket":"/var/lib/workflowd-gateway/control/control.sock","daemon":{"uid":<daemon-uid>,"gid":<daemon-gid>},"login":{"directory":"/var/lib/workflowd-gateway/login"},"providerId":"anthropic","credentialRole":"claude","maxStreams":64,"maxStreamsPerRun":4,"gitRead":true,"listen":{"socket":"/var/lib/workflowd-gateway/front/gateway.sock","front":{"uid":<front-uid>,"gid":<front-gid>},"service":"<service-name>.<tailnet-name>.ts.net"}}'
