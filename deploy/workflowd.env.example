# Required non-secret GitHub App settings
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/home/example/.config/workflowd/github-app.pem

# OpenCode must use the same username and password as opencode-server.service.
OPENCODE_SERVER_USERNAME=opencode
# Comma-separated GitHub usernames; leave empty to disable commands.
WORKFLOWD_COMMAND_USERS=example-user
# Safe default. Enable only when agent-owned pull requests are trusted to run
# repository verification commands on this host.
WORKFLOWD_FIX_WORK_ENABLED=false
# Required when Fix Work is enabled. This is a comma-separated allowlist of the
# PR author's exact GitHub login (matched case-insensitively). It applies to all
# Fix Work, including already queued jobs and `/agent fix` requests. Repository
# access and an eligible branch name do not confer trust.
# WORKFLOWD_TRUSTED_AGENT_USERS=trusted-agent[bot]
# Required when Fix Work is enabled. Use the full OpenPGP fingerprint for a
# controller key registered with GitHub; fixer commits are signed with this key.
# WORKFLOWD_GIT_SIGNING_KEY=0123456789abcdef0123456789abcdef01234567

# The systemd unit supplies these from LoadCredential. Do not also set the
# direct variables in the installed EnvironmentFile.
# GITHUB_WEBHOOK_SECRET_FILE=/run/credentials/.../github-webhook-secret
# OPENCODE_SERVER_PASSWORD_FILE=/run/credentials/.../opencode-server-password
# Optional authenticated test-job canary API. Omit both sources to keep its
# routes disabled. When enabled, set exactly one source.
# WORKFLOWD_TEST_JOB_TOKEN_FILE=/run/credentials/.../workflowd-test-job-token
# Optional authenticated agent-wait ingress (POST /workflows/agent-waits),
# which the MCP server's wait_for_agent tool proxies to. Omit both sources to
# keep the route disabled. When enabled, set exactly one source.
# WORKFLOWD_AGENT_WAIT_TOKEN_FILE=/run/credentials/.../workflowd-agent-wait-token

# For local development without systemd, set exactly one source per secret.
# GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret
# OPENCODE_SERVER_PASSWORD=replace-with-the-local-server-password
# GITHUB_WEBHOOK_SECRET_FILE=/absolute/path/to/webhook-secret
# OPENCODE_SERVER_PASSWORD_FILE=/absolute/path/to/opencode-password
# WORKFLOWD_TEST_JOB_TOKEN=replace-with-a-random-secret
# WORKFLOWD_TEST_JOB_TOKEN_FILE=/absolute/path/to/workflowd-test-job-token
# WORKFLOWD_AGENT_WAIT_TOKEN=replace-with-a-random-secret
# WORKFLOWD_AGENT_WAIT_TOKEN_FILE=/absolute/path/to/workflowd-agent-wait-token

# HTTP
# WORKFLOWD_HOST=127.0.0.1
# WORKFLOWD_PORT=8787
# WORKFLOWD_MAX_WEBHOOK_BYTES=1048576

# OpenCode
# Stable identity of the machine that owns local session custody records.
WORKFLOWD_HOST_ID=mint
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# Credential-free URL reachable from reviewer tailnet machines.
WORKFLOWD_OPENCODE_ATTACH_URL=https://mint.example-tailnet.ts.net:4096
# WORKFLOWD_OPENCODE_SERVER_ID=opencode-primary
# WORKFLOWD_OPENCODE_ENDPOINT_ALIAS=private-opencode
# WORKFLOWD_MODEL=openai/gpt-5.6-sol
# WORKFLOWD_REVIEWER_AGENT=pr-reviewer
# WORKFLOWD_FIXER_AGENT=pr-fixer
# Agent used to prompt a parent session woken by an agent wait.
# WORKFLOWD_AGENT_WAKE_AGENT=build
# WORKFLOWD_OPENCODE_POLL_INTERVAL_MS=1000

# Storage and workspace
# WORKFLOWD_STATE_DIR=/home/example/.local/state/workflowd
# WORKFLOWD_CACHE_DIR=/home/example/.local/share/workflowd
# WORKFLOWD_DATABASE_PATH=/home/example/.local/state/workflowd/workflowd.db
# WORKFLOWD_REPOSITORY_ROOT=/home/example/.local/share/workflowd/repositories
# WORKFLOWD_WORKTREE_ROOT=/home/example/.local/share/workflowd/worktrees
# OPENCODE_WORKTREE_REGISTRY=/home/example/.local/share/opencode/worktree-jobs
# Colon-separated repository roots:
# WORKFLOWD_LOCAL_REPOSITORIES=/home/example/Documents/repos
# WORKFLOWD_MAX_DIFF_BYTES=2000000

# Worker policy
# WORKFLOWD_WORKER_CONCURRENCY=2
# WORKFLOWD_POLL_INTERVAL_MS=1000
# WORKFLOWD_JOB_TIMEOUT_MS=1800000
# WORKFLOWD_JOB_LEASE_MS=1860000
# WORKFLOWD_PUBLICATION_TIMEOUT_MS=60000
# WORKFLOWD_PUBLICATION_LEASE_MS=120000
# Comma-separated, non-empty branch prefixes:
# WORKFLOWD_AGENT_BRANCH_PREFIXES=opencode/,plan/

# Optional kernel-backed remote probe coordinator. NATS credential material
# stays out of this file; the systemd unit supplies it via LoadCredential.
# Set exactly one source among WORKFLOWD_NATS_TOKEN, WORKFLOWD_NATS_TOKEN_FILE,
# WORKFLOWD_NATS_CREDS, and WORKFLOWD_NATS_CREDS_FILE (empty values count as
# unset so drop-ins can disable a source set elsewhere).
# WORKFLOWD_REMOTE_COORDINATOR_ENABLED=true
# WORKFLOWD_NATS_SERVERS=tls://nats.example-tailnet.ts.net:4222
# Per-identity mode (recommended; see docs/remote-runner.md): install the
# coordinator .creds file and a workflowd.service.d/20-nats.conf drop-in:
#   [Service]
#   LoadCredential=nats-creds:%h/.config/workflowd/coordinator.creds
#   Environment=WORKFLOWD_NATS_CREDS_FILE=%d/nats-creds
# WORKFLOWD_NATS_CREDS_FILE=/run/credentials/workflowd.service/nats-creds
# Shared-token mode (smoke tests only; a token carries no subject
# permissions):
# WORKFLOWD_NATS_TOKEN_FILE=/run/credentials/.../nats-token
# WORKFLOWD_REMOTE_LEASE_MS=60000
# WORKFLOWD_REMOTE_COMMAND_TTL_MS=300000
