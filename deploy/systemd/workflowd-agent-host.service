[Unit]
Description=Workflowd agent host
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/workflowd-agent-host
RuntimeDirectory=workflowd-agent-host
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN
ReadWritePaths=/var/lib/workflowd/model-credentials /var/lib/workflowd/agent-host /var/lib/workflowd/agent-io /run/workflowd-agent-host
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
Restart=on-failure

[Install]
WantedBy=multi-user.target
