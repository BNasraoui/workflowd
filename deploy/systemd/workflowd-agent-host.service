[Unit]
Description=Workflowd credential admission
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/workflowd-agent-host
RuntimeDirectory=workflowd-agent-host
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/workflowd/model-credentials /run/workflowd-agent-host
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
Restart=on-failure

[Install]
WantedBy=multi-user.target
