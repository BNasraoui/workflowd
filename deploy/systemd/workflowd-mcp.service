[Unit]
Description=Workflowd remote MCP server (fire-and-ack dispatch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/repos/workflowd
Environment=HOME=%h
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/workflowd/mcp.env
LoadCredential=mcp-token:%h/.config/workflowd/mcp-token
Environment=WORKFLOWD_MCP_TOKEN_FILE=%d/mcp-token
# Lets wait_for_agent proxy to the daemon's agent-wait ingress. Drop both
# lines (and WORKFLOWD_DAEMON_URL from mcp.env) to keep the tool disabled.
LoadCredential=agent-wait-token:%h/.config/workflowd/agent-wait-token
Environment=WORKFLOWD_AGENT_WAIT_TOKEN_FILE=%d/agent-wait-token
# Lets dispatch_agent proxy to the daemon's agent-run ingress. Drop both
# lines to keep the tool disabled.
LoadCredential=agent-run-token:%h/.config/workflowd/agent-run-token
Environment=WORKFLOWD_AGENT_RUN_TOKEN_FILE=%d/agent-run-token
ExecStart=%h/.bun/bin/bun run mcp
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/workflowd
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=default.target
