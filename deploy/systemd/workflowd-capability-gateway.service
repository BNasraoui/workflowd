[Unit]
Description=Workflowd capability gateway (runner sessions and model calls)
After=network-online.target
Wants=network-online.target
# Independent of workflowd.service: either restarts without stopping the other, and
# runs keep their bindings in the shared store across both restarts.

[Service]
Type=simple
WorkingDirectory=/opt/workflowd/deploy/current
Environment=HOME=%h
Environment=PATH=/opt/workflowd/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# WORKFLOWD_CAPABILITY_GATEWAY (with its listen address) and the store path come from the
# operator's workflowd configuration, so both processes read one gateway section.
EnvironmentFile=%h/.config/workflowd/env
ExecStart=/opt/workflowd/bin/bun /opt/workflowd/deploy/current/src/capability-gateway-server.ts
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/workflowd %h/.local/share/workflowd
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=default.target
