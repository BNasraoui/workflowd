    "requirementIntents": [
      {
        "canonicalContentSha256": "7a12ca130aece12f154b5f9365bb9cf21f8b2e379cd6c9ddac8783cbfce5ebef",
        "create": {
          "description": "AC1: file-backed migrations create every required runtime record without rewriting legacy rows. AC2: domain and SQL constraints enforce currentness, immutable history, monotonic replacement, and tagged transitions. AC3: every mutation atomically rechecks Generation, operation revision, lease, and pointers. AC4: malformed durable data is quarantined with exact diagnostics and no guessed advancement. AC5: restart recovers leases, pointers, diagnostics, and uncertain intent. AC6: no owner lifecycle, status, or capacity state is introduced.",
          "id": "wvs343-r3-67779296-req-accepted",
          "scope": "workflowd-vs3-4-3",
          "statement": "Implement the complete accepted stage-runtime state contract without adding excluded owner, status, or capacity lifecycles.",
          "status": "active"
        },
        "kind": "requirement",
        "logicalId": "accepted-requirements"
      },
      {
        "canonicalContentSha256": "66d3e8e98ab5764cfa3dabeacbc30fca8019cf3dac0ac32a1e5e17aec8a7efa7",
        "create": {
          "description": "V1 proves strict SQL and semantic shape. V2 proves all-dimension stale fencing, rollback, and reload. V3 proves nonclaimable placeholders and atomic idempotent recoverable bootstrap. V4 proves exact corruption containment and retained uncertain-effect evidence. V5 proves append-only legacy preservation, format diagnostics, and claim guards. V6 is owned by workflowd-vs3.4.11 and proves exact offline legacy recovery and authenticated successor kickoff before exposure.",
          "id": "wvs343-r3-67779296-req-verification",
          "scope": "workflowd-vs3-4-3",
          "statement": "Produce all accepted V1 through V6 verification evidence before the corresponding control or residual-risk condition is treated as satisfied.",
          "status": "active"
        },
        "kind": "requirement",
        "logicalId": "verification-obligations"
      }
    ],
    "resolutionIntents": [
      {
        "canonicalContentSha256": "5ce44c5e0905f458ed5412327508e9acd883f9ef97b86a2f798ff0c5d52e6e07",
        "create": {
          "id": "wvs343-r3-67779296-res-decisions",
          "input-reference": "wvs343-r3-67779296-src-design",
          "input-summary": "Locally accepted Design revision 3; production gate authentication and authority remain unclaimed.",
          "input-type": "source_material",
          "made-by": "Design revision 3 producer; production session identity unavailable",
          "position": "D1 persist historical tagged runtime records and diagnostics; D2 put revision pointers on StageRun and the linear cursor on Generation; D3 bind shared WorkflowOperations to exact revisions or steps; D4 combine strict SQLite with strict Schema, identity, and hash checks; D5 fence every authority dimension in each mutation; D6 replace revisions monotonically without conflating operation retry; D7 quarantine corrupt revisions into abandoned revision and data_error run with no successor; D8 bootstrap atomically and idempotently from nonclaimable stage_snapshots_v1 to stage_runtime_v1; D9 resume exact new-format state and preserve legacy facts; D10 verify with real SQLite and file-backed restart tests.",
          "rationale": "These decisions preserve exact authority, immutable history, fail-closed recovery, and the accepted neighboring-ticket boundaries.",
          "requirement-id": "wvs343-r3-67779296-req-accepted",
          "scope": "workflowd-vs3-4-3",
          "status": "approved",
          "title": "Accepted Design decisions D1 through D10"
        },
        "kind": "resolution",
        "logicalId": "design-decisions"
      },
      {
        "canonicalContentSha256": "631f8cec45929a88486f5cb75ffc55d8611e148e7da816edd61d7a5028c8f934",
        "create": {
          "id": "wvs343-r3-67779296-res-risks",
          "input-reference": "wvs343-r3-67779296-src-impact",
          "input-summary": "ImpactReady with all conditional dispositions retained by the local gate.",
          "input-type": "source_material",
          "made-by": "Impact review and synthesis; production reviewer identities unavailable",
          "position": "R1 malformed authority is NonMaterial only after C1, C4, and C7 pass V1 and V4. R2 stale advancement is NonMaterial only after C2 and C7-C9 pass V2. R3 unsafe bootstrap is NonMaterial only after C3 and C7-C9 pass V3. R4 corrupt aggregate with uncertain effects is NonMaterial for containment only after C1, C4, C5, and C7 pass V4; future recovery is not assumed. R5 legacy or partial-format exposure is NonMaterial only under C6 and C10-C12 after V5 and V6.",
          "rationale": "No risk is accepted as already satisfied, no control or evidence is waived, no matrix score is fabricated, and all outstanding conditions and uncertainty remain.",
          "requirement-id": "wvs343-r3-67779296-req-verification",
          "scope": "workflowd-vs3-4-3",
          "status": "approved",
          "title": "Conditional residual-risk dispositions R1 through R5"
        },
        "kind": "resolution",
        "logicalId": "residual-risks"
      },
      {
        "canonicalContentSha256": "54277801e04a3b23fa629a87c99203def83e0926bd58d7c0ca2ff33d1d835455",
        "create": {
          "id": "wvs343-r3-67779296-res-ownership",
          "input-reference": "wvs343-r3-67779296-src-ownership",
          "input-summary": "ScopeClean ownership review retained unchanged.",
          "input-type": "source_material",
          "made-by": "Ownership review and synthesis; production reviewer identities unavailable",
          "position": "O1 workflowd-vs3.4.3 owns durable tagged runtime records, strict decode, guarded transitions, bootstrap, quarantine, and local verification. O2 workflowd-vs3.4.4 owns producer, session, workspace, and custody behavior. O3 workflowd-vs3.4.5 owns Git publication and artifact insertion. O4 workflowd-vs3.4.6 owns TargetReconcile. O5 workflowd-vs3.4.7 owns run selection and progression. O6 workflowd-vs3.4.8 owns handoff delivery. O7 workflowd-vs3.4.9 owns Design effects, graph verification, Structure release, and reentry. O8 workflowd-vs3.4.10 owns runtime composition. O9 workflowd-vs3.4.11 owns offline legacy recovery. O10 workflowd-vs3.4.12 owns integrated verification.",
          "rationale": "The assignments preserve current-ticket scope and explicit downstream authority without creating their lifecycles here.",
          "requirement-id": "wvs343-r3-67779296-req-accepted",
          "scope": "workflowd-vs3-4-3",
          "status": "approved",
          "title": "Accepted ownership assignments O1 through O10"
        },
        "kind": "resolution",
        "logicalId": "ownership-assignments"
      }
    ],
